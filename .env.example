# Partner API connection
PARTNER_API_BASE_URL=https://api.partner.example.com

# Auth0 OAuth2 (machine-to-machine, used by apps/api to get partner API tokens)
AUTH0_TOKEN_URL=https://your-tenant.auth0.com/oauth/token
PARTNER_API_CLIENT_ID=your-client-id-here
PARTNER_API_CLIENT_SECRET=your-client-secret-here

# Mock mode — when true, API returns fixture data instead of calling the live partner API
USE_MOCK_API=true

# Auth0 config for verifying incoming frontend JWTs (required when USE_MOCK_API=false)
AUTH0_ISSUER_DOMAIN=your-tenant.auth0.com
AUTH0_AUDIENCE_URL=https://api.partner.example.com

# Timeout for outbound partner API requests in ms (default: 10000)
PARTNER_API_TIMEOUT_MS=10000

# App base URL (used for CORS and OAuth redirect)
APP_BASE_URL=http://localhost:3000

# Runtime environment
NODE_ENV=development

# Logging level: trace | debug | info | warn | error | fatal
LOG_LEVEL=info
