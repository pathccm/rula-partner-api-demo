# Auth0 SPA application credentials
VITE_AUTH0_ISSUER_DOMAIN=your-tenant.auth0.com
VITE_AUTH0_CLIENT_ID=your-spa-client-id-here
VITE_AUTH0_AUDIENCE_URL=https://api.partner.example.com

# API base URL. Set to http://localhost:4000 for local dev (Vite dev server runs separately).
# Leave empty (or omit) when the frontend is served directly from the API server.
VITE_API_BASE_URL=http://localhost:4000

# Shared API key — must match API_KEY in apps/api/.env.
# Leave unset when API_KEY enforcement is disabled on the server.
VITE_API_KEY=
