# Optional: override the API server URL for local development.
# Defaults to http://localhost:4004 via the Vite proxy.
# Leave unset when the frontend is served by the API (production).
# VITE_API_BASE_URL=http://localhost:4004

# Shared API key — must match API_KEY in apps/api/.env.
# Leave unset when API_KEY enforcement is disabled on the server.
VITE_API_KEY=
