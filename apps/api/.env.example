# Server
PORT=4004
NODE_ENV=development
LOG_LEVEL=info

# When true, all partner API requests use mock handlers (no credentials needed).
# When false and credentials are present, requests hit the real partner API.
USE_MOCK_API=true

# Partner API
PARTNER_API_BASE_URL=https://api.example.com
PARTNER_API_AUDIENCE=https://api.example.com/partner-scheduling-api-server-staging
PARTNER_API_CLIENT_ID=your-client-id
PARTNER_API_CLIENT_SECRET=your-client-secret
PARTNER_API_TIMEOUT_MS=10000

# Auth0 (used to obtain partner API access tokens via client credentials)
AUTH0_TOKEN_URL=https://your-tenant.auth0.com/oauth/token

# Shared API key for protecting BFF routes.
# When set, all /v1/* requests must include a matching x-api-key header.
# Leave unset for local development (enforcement is skipped).
API_KEY=

# CORS — set to the frontend origin
APP_BASE_URL=http://localhost:3000
