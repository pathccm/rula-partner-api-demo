# Server
PORT=4000
NODE_ENV=development
LOG_LEVEL=info

# When true, all routes use mock data from mocks/*.json
USE_MOCK_API=true

# Rula Partner API
PARTNER_API_BASE_URL=https://api.rula.com
PARTNER_API_CLIENT_ID=your-client-id
PARTNER_API_CLIENT_SECRET=your-client-secret
PARTNER_API_TIMEOUT_MS=10000

# Auth0 — used for two purposes:
# 1. M2M token for calling the partner API (AUTH0_TOKEN_URL, CLIENT_ID, CLIENT_SECRET above)
# 2. Verifying incoming frontend JWTs (ISSUER_DOMAIN, AUDIENCE_URL below)
AUTH0_TOKEN_URL=https://your-tenant.auth0.com/oauth/token
AUTH0_ISSUER_DOMAIN=your-tenant.auth0.com
AUTH0_AUDIENCE_URL=https://your-api-identifier

# Shared API key for protecting BFF routes.
# When set, all /v1/* requests must include a matching x-api-key header.
# Leave unset for local development (enforcement is skipped).
API_KEY=

# CORS — set to the frontend origin
APP_BASE_URL=http://localhost:3000
